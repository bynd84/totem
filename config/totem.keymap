#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define wsad   0
#define beakl   1
#define qwerty   2
#define qwerty_digits    3
#define wsad_nav   4
#define fk   5
#define np    6
#define qwerty_numpad    7
#define mouse    8
#define mouse3    9
#define ZMK_POINTING_DEFAULT_MOVE_VAL 80  // default: 600

&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

&mt {
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        wsad_toggle {
            bindings = <&tog 1>;
            key-positions = <25 21>;
            layers = <0 1 2>;
        };

        numpad {
            bindings = <&tog 6>;
            key-positions = <6 8 7>;
            layers = <1 6 2>;
        };

        mouse {
            bindings = <&tog 8>;
            key-positions = <15 19>;
            layers = <8 1 2>;
        };

        toggle_left_nav {
            bindings = <&tog 4>;
            key-positions = <4 0>;
            layers = <1 4 0 2>;
        };

        st_numpad {
            bindings = <&sl 6>;
            key-positions = <6 8>;
            layers = <1 2>;
        };

        mouse3 {
            bindings = <&tog 9>;
            key-positions = <10 14>;
            layers = <1 9 0 2>;
        };

        br_l {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 28>;
            layers = <1 2>;
        };

        br_r {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 29>;
            layers = <1 2>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <8 18>;
            layers = <2>;
        };

        st_fkeys {
            bindings = <&sl 5>;
            key-positions = <13 14>;
            layers = <1 0 2>;
            timeout-ms = <15>;
        };

        shift1 {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <27 16>;
            layers = <1 2>;
        };

        shift2 {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <1 11>;
            layers = <1 2>;
        };

        shift3 {
            bindings = <&kp LS(NUMBER_3)>;
            key-positions = <2 12>;
            layers = <1 2>;
        };

        shift4 {
            bindings = <&kp LS(NUMBER_4)>;
            key-positions = <3 13>;
            layers = <1 2>;
        };

        shift5 {
            bindings = <&kp LS(N5)>;
            key-positions = <4 14>;
            layers = <1 2>;
        };

        shift6 {
            bindings = <&kp LS(NUMBER_6)>;
            key-positions = <5 15>;
            layers = <1>;
        };

        shift7 {
            bindings = <&kp LS(N7)>;
            key-positions = <6 16>;
            layers = <1 2>;
        };

        shift8 {
            bindings = <&kp LS(N8)>;
            key-positions = <7 17>;
            layers = <1 2>;
        };

        shift9 {
            bindings = <&kp LS(N9)>;
            key-positions = <22 11>;
            layers = <1 2>;
        };

        shift0 {
            bindings = <&kp LS(N0)>;
            key-positions = <12 23>;
            layers = <1 2>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <13 24>;
            layers = <1 2>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <14 25>;
            layers = <1 2>;
        };

        qwerty_l {
            bindings = <&tog 2>;
            key-positions = <20 34>;
            layers = <1 2>;
        };

        qwerty_r {
            bindings = <&tog 2>;
            key-positions = <35 31>;
            layers = <1 2>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <8 18>;
            layers = <1>;
        };

        q_br_l {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <22 11 33>;
            layers = <0>;
        };

        q_br_r {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <23 12 33>;
            layers = <0>;
        };

        q_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <1 11 33>;
            layers = <0>;
        };

        qwerty_5 {
            bindings = <&kp N5>;
            key-positions = <1 11>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <12 2>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_7 {
            bindings = <&kp N7>;
            key-positions = <3 13>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_8 {
            bindings = <&kp N8>;
            key-positions = <4 14>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_9 {
            bindings = <&kp N9>;
            key-positions = <1 2>;
            layers = <0>;
            timeout-ms = <50>;
        };

        qwerty_0 {
            bindings = <&kp N0>;
            key-positions = <3 2>;
            layers = <0>;
            timeout-ms = <50>;
        };

        qwerty_z {
            bindings = <&kp Z>;
            key-positions = <22 11>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_x {
            bindings = <&kp X>;
            key-positions = <23 12>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_c {
            bindings = <&kp C>;
            key-positions = <24 13>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_v {
            bindings = <&kp V>;
            key-positions = <14 25>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_t {
            bindings = <&kp T>;
            key-positions = <22 23>;
            layers = <0>;
            timeout-ms = <50>;
        };

        qwerty_g {
            bindings = <&kp G>;
            key-positions = <23 24>;
            layers = <0>;
            timeout-ms = <50>;
        };

        qwerty_b {
            bindings = <&kp B>;
            key-positions = <24 25>;
            layers = <0>;
            timeout-ms = <15>;
        };

        qwerty_min {
            bindings = <&kp MINUS>;
            key-positions = <33 12 2>;
            layers = <0>;
        };

        qwerty_equ {
            bindings = <&kp EQUAL>;
            key-positions = <33 3 13>;
            layers = <0>;
        };

        qwerty_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <50>;
        };

        nump {
            bindings = <&tog 7>;
            key-positions = <1 2 3>;
            layers = <1 0 2 7>;
            timeout-ms = <15>;
        };

        qwerty_y {
            bindings = <&kp Y>;
            key-positions = <4 33>;
            layers = <0>;
        };

        qwerty_u {
            bindings = <&kp U>;
            key-positions = <33 3>;
            layers = <0>;
        };

        qwerty_i {
            bindings = <&kp I>;
            key-positions = <33 2>;
            layers = <0>;
        };

        qwerty_o {
            bindings = <&kp O>;
            key-positions = <33 1>;
            layers = <0>;
        };

        qwerty_p {
            bindings = <&kp P>;
            key-positions = <33 0>;
            layers = <0>;
        };

        qwerty_h {
            bindings = <&kp H>;
            key-positions = <33 14>;
            layers = <0>;
        };

        qwerty_j {
            bindings = <&kp J>;
            key-positions = <33 13>;
            layers = <0>;
        };

        qwerty_k {
            bindings = <&kp K>;
            key-positions = <33 12>;
            layers = <0>;
        };

        qwerty_l_key {
            bindings = <&kp L>;
            key-positions = <33 11>;
            layers = <0>;
        };

        qwerty_n {
            bindings = <&kp N>;
            key-positions = <33 25>;
            layers = <0>;
        };

        qwerty_m {
            bindings = <&kp M>;
            key-positions = <33 24>;
            layers = <0>;
        };

        qwerty_comma {
            bindings = <&kp COMMA>;
            key-positions = <33 23>;
            layers = <0>;
        };

        qwerty_period {
            bindings = <&kp PERIOD>;
            key-positions = <33 22>;
            layers = <0>;
        };

        qwerty_sk {
            bindings = <&kp SEMI>;
            key-positions = <33 13 24>;
            layers = <0>;
        };

        qwerty_slash {
            bindings = <&kp SLASH>;
            key-positions = <33 14 25>;
            layers = <0>;
        };

        qwerty_bslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <33 14 4>;
            layers = <0>;
        };

        wsad_cpgup {
            bindings = <&kp LC(PG_UP)>;
            key-positions = <32 12>;
            layers = <0>;
            timeout-ms = <45>;
        };

        wsad_cpgdn {
            bindings = <&kp LC(PAGE_DOWN)>;
            key-positions = <32 23>;
            layers = <0>;
            timeout-ms = <45>;
        };

        num_div {
            bindings = <&kp KP_DIVIDE>;
            key-positions = <1 11>;
            layers = <7>;
        };

        num_mult {
            bindings = <&kp KP_MULTIPLY>;
            key-positions = <2 12>;
            layers = <7>;
        };

        num_minus {
            bindings = <&kp KP_SUBTRACT>;
            key-positions = <3 13>;
            layers = <7>;
        };

        num_plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <13 24>;
            layers = <7>;
        };

        num_nlock {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <22 11>;
            layers = <7>;
        };

        num_ent {
            bindings = <&kp KP_ENTER>;
            key-positions = <23 12>;
            layers = <7>;
        };
    };

    behaviors {
        wasd_nums: wasd_nums {
            compatible = "zmk,behavior-hold-tap";
            label = "WASD_NUMS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };

        hl_mod: hl_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HL_MOD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };

        layer_stlayer: layer_stlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_STLAYER";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };

        kp_stlayer: kp_stlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_STLAYER";
            bindings = <&kp>, <&sl>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        wsad {
            bindings = <
           &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4       &trans  &trans  &trans  &trans  &trans
           &kp LALT   &kp A   &kp W   &kp D   &kp F        &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp LCTRL  &kp Q   &kp S   &kp E   &kp R        &trans  &trans  &trans  &trans  &trans  &trans
                              &mo 7   &mo 4   &kp SPACE    &trans  &trans  &trans
            >;

            label = "wsad";
        };

        beakl19bis {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "beakl19bis";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                &kp Q  &kp Y     &kp O     &kp U    &kp Z        &kp W      &kp D      &kp N  &kp C  &kp K
                &kp H  &kp I     &kp E     &kp A    &kp COMMA    &kp G      &kp T      &kp R  &kp S  &kp P
&mt LALT GRAVE  &kp J  &kp APOS  &kp FSLH  &kp DOT  &kp X        &kp V      &kp M      &kp L  &kp F  &kp B  &mt RALT BACKSLASH
                                 &none     &mo 4    &kp LSHFT    &kp SPACE  &kp LCTRL  &mo 3
            >;
        };

        qwerty {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G        &kp H      &kp J      &kp K      &kp L    &kp SEMI
&mt LALT GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &mt RIGHT_ALT BSLH
                              &none  &mo 4  &kp LSHFT    &kp SPACE  &kp LCTRL  &mo 3
            >;

            label = "qwerty";
        };

        qwerty_digits {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans             &kp N7  &kp N8  &kp N9  &kp GRAVE
        &trans  &trans  &trans  &trans  &trans    &kp C_VOLUME_UP    &kp N4  &kp N5  &kp N6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_VOLUME_DOWN  &kp N1  &kp N2  &kp N3  &trans     &kp LGUI
                        &trans  &trans  &trans    &trans             &trans  &trans
            >;

            label = "qwerty_digits";
        };

        wsad_nav {
            label = "wsad_nav";
            bindings = <
                 &kp TAB        &kp HOME        &kp BSPC      &kp END          &kp PG_UP        &trans  &trans  &trans  &trans  &trans
                 &kp RIGHT_ALT  &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN    &trans  &trans  &trans  &trans  &trans
&kp RIGHT_SHIFT  &kp RCTRL      &kp ESC         &kp DOWN      &kp ENTER        &kp DEL          &trans  &trans  &trans  &trans  &trans  &trans
                                                &mo 5         &mo 5            &kp INS          &trans  &trans  &trans
            >;
        };

        Fkeys {
            bindings = <
          &kp LGUI           &kp F7  &kp F8     &kp F9          &kp F10            &trans  &trans  &trans  &trans  &trans
          &kp C_VOLUME_UP    &kp F4  &kp F5     &kp F6          &kp F11            &trans  &trans  &trans  &trans  &trans
&kp CAPS  &kp C_VOLUME_DOWN  &kp F1  &kp F2     &kp F3          &kp F12            &trans  &trans  &trans  &trans  &trans  &trans
                                     &kp PSCRN  &kp SCROLLLOCK  &kp PAUSE_BREAK    &trans  &trans  &trans
            >;

            label = "fk";
        };

        numpad {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8  &kp KP_N9  &none
        &trans  &trans  &trans  &trans  &trans    &kp KP_MULTIPLY  &kp KP_NUMBER_4  &kp KP_N5  &kp KP_N6  &kp KP_NUMBER_0
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_MINUS     &kp KP_N1        &kp KP_N2  &kp KP_N3  &kp KP_PLUS      &kp KP_NUM
                        &trans  &trans  &trans    &kp KP_DOT       &kp KP_ENTER     &none
            >;

            label = "np";
        };

        qwerty_numpad {
            bindings = <
        &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_N0     &trans  &trans  &trans  &trans  &trans
        &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DOT    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none         &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans           &none            &none         &trans  &trans  &trans
            >;

            label = "qwerty_numpad";
        };

        mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans             &mmv MOVE_X(-1400)  &mmv MOVE_Y(-1400)  &mmv MOVE_X(1400)  &trans
        &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP       &mmv MOVE_LEFT      &mmv MOVE_UP        &mmv MOVE_RIGHT    &mkp LCLK
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN     &mkp LCLK           &mkp MCLK           &mkp RCLK          &mkp RCLK  &trans
                        &trans  &trans  &trans    &mmv MOVE_Y(1400)  &mmv MOVE_DOWN      &trans
            >;

            label = "mouse";
        };

        mouse3 {
            bindings = <
        &trans     &mmv MOVE_X(-1400)  &mmv MOVE_Y(-1400)  &mmv MOVE_X(1400)  &trans               &trans  &trans  &trans  &trans  &trans
        &mkp LCLK  &mmv MOVE_LEFT      &mmv MOVE_UP        &mmv MOVE_RIGHT    &msc SCRL_UP         &trans  &trans  &trans  &trans  &trans
&trans  &mkp RCLK  &mkp RCLK           &mkp MCLK           &mkp LCLK          &msc SCRL_DOWN       &trans  &trans  &trans  &trans  &trans  &trans
                                       &none               &mmv MOVE_DOWN     &mmv MOVE_Y(1400)    &trans  &trans  &trans
            >;

            label = "mouse3";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
